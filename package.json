{
  "name": "awayuki-desktop",
  "version": "0.7.1",
  "private": true,
  "packageManager": "bun@1.3.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "bundle:check": "bun scripts/check-bundle-budget.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint frontend/src vite.config.ts vitest.config.ts",
    "version:check": "bun scripts/check-version-consistency.mjs",
    "docs:check": "bun scripts/check-doc-links.mjs",
    "architecture:check": "bun scripts/check-architecture-adr.mjs",
    "csp:check": "bun scripts/check-csp-policy.mjs && bun scripts/audit-csp-sources.mjs",
    "portable-state:check": "bun scripts/check-portable-state.mjs",
    "startup:check": "bun scripts/check-startup-boundaries.mjs",
    "release:check": "bun scripts/check-release-boundaries.mjs",
    "ipc:generate": "bun scripts/generate-ipc-contract.mjs",
    "ipc:check": "bun scripts/generate-ipc-contract.mjs --check",
    "benchmark:db": "bun scripts/benchmark-db.mjs",
    "benchmark:system": "bun scripts/benchmark-system.mjs",
    "benchmark:timeline": "bun scripts/benchmark-timeline.mts",
    "benchmark:webview": "bun scripts/benchmark-webview.mjs",
    "benchmark:bluesky": "bun scripts/benchmark-bluesky-polling.mjs",
    "dependency:metrics": "bun scripts/dependency-metrics.mjs build/dependency-metrics.json docs/baselines/dependency-features-before.json",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/legacy-modes": "^6.5.3",
    "@hello-pangea/dnd": "^18.0.1",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "codemirror": "^6.0.2",
    "daisyui": "^4.12.0",
    "full-emoji-list": "17.0.3",
    "lucide-react": "^0.468.0",
    "perfect-scrollbar": "^1.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtuoso": "^4.18.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.12.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
