# Created by https://www.toptal.com/developers/gitignore/api/rust
# Edit at https://www.toptal.com/developers/gitignore?templates=rust

### Rust ###
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# End of https://www.toptal.com/developers/gitignore/api/rust

# Local debug
awayuki.db
awayuki.db-shm
awayuki.db-wal
awayuki.log
awayuki.log.*
awayuki-support-*.zip
*.dmp
*.crash
window_state.json
/plugins/

# Build artifacts
build/
frontend/dist/
gen/
*.dmg
*.zip
*.p12

# Frontend dependencies
node_modules/

# Arch Linux (makepkg)
# NOTE: makepkg also creates a $startdir/src/ scratch dir, but that name
# collides with this project's Rust source directory, so it is intentionally
# NOT listed here. The PKGBUILD redirects cargo output to build/ instead.
pkg/
*.pkg.tar.zst
*.pkg.tar.xz

# macOS
.DS_Store

# Claude Code
.claude/settings.local.json
.claude/worktrees/
